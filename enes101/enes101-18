<!DOCTYPE html>
<html lang="id" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IOU Module 18 Simulation (Randomized & Visualized)</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-color: #1e1e1e;
            --text-primary: #e0e0e0;
            --text-secondary: #a0a0a0;
            --accent-color: #4da6ff;
            --correct-color: #4caf50;
            --wrong-color: #f44336;
            --border-radius: 12px;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 700px;
        }

        /* Header */
        header {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #333;
        }

        h1 { font-size: 1.5rem; margin: 0; color: var(--accent-color); }
        p.subtitle { color: var(--text-secondary); font-size: 0.9rem; margin-top: 5px; }

        /* Card Style */
        .card {
            background-color: var(--card-color);
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            margin-bottom: 20px;
        }

        .meta-tags {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 0.8rem;
        }

        .video-tag {
            background-color: #333;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
        }

        .category-tag {
            background-color: #2c3e50;
            color: #4da6ff;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            border: 1px solid #4da6ff;
        }

        .question-text {
            font-size: 1.15rem;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        /* Options */
        .options {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-label {
            display: flex;
            align-items: flex-start;
            padding: 15px;
            border: 1px solid #444;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .option-label:hover {
            background-color: #2c2c2c;
            border-color: var(--accent-color);
        }

        .option-label input {
            margin-top: 5px;
            margin-right: 15px;
            accent-color: var(--accent-color);
            transform: scale(1.2);
        }

        /* Buttons */
        .btn {
            background-color: var(--accent-color);
            color: #000;
            border: none;
            padding: 14px 24px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            font-size: 1rem;
            margin-top: 10px;
            transition: opacity 0.2s;
        }
        
        .btn-nav {
            background-color: #333; 
            color: #fff; 
            border: 1px solid #555;
            margin-bottom: 15px;
        }

        .btn:hover { opacity: 0.9; }

        /* Dashboard Button Highlight */
        .btn-dashboard {
            background-color: #ff9800;
            color: #fff;
        }
        .btn-dashboard:hover {
            background-color: #e68a00;
        }

        /* Results & Review */
        .result-box {
            text-align: center;
            padding: 40px;
        }
        
        .score-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #333;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            border: 5px solid var(--accent-color);
        }

        .score-number { font-size: 2.2rem; font-weight: bold; color: var(--accent-color); }
        .score-label { font-size: 0.8rem; color: #aaa; margin-top: -5px; }

        .review-item {
            background-color: #252525;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 6px solid #555;
            text-align: left;
        }

        .review-item.correct { border-left-color: var(--correct-color); }
        .review-item.wrong { border-left-color: var(--wrong-color); }

        .review-explanation {
            background-color: #333; 
            border: 1px solid #FFD700; 
            padding: 15px; 
            margin-top: 15px; 
            border-radius: 8px;
        }
        
        .indonesian-flag {
            font-size: 0.95rem;
            color: #FFD700; 
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .explanation-text {
            color: #fff;
            margin: 0;
            font-size: 1rem;
            line-height: 1.5;
        }

        .step { display: none; }
        .step.active { display: block; }

    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>IOU Module 18 Simulation</h1>
        <p class="subtitle">Punctuation: Comma, Colon & Apostrophe</p>
    </header>

    <form id="quizForm">
        <div id="quiz-container">
            <p style="text-align:center; color: #666;">Memuat soal...</p>
        </div>
    </form>
</div>

<script>
    const rawQuizData = [
        {
            id: 1,
            video: "Video 18e",
            category: "C2 - Memahami (20 Poin)",
            points: 20,
            text: "Which statement best explains why a comma is necessary in the sentence: 'Because it was raining, I took my umbrella'?",
            options: [
                "The comma separates a dependent introductory clause from the main independent clause.",
                "The comma is used to join two independent clauses to form a compound sentence.",
                "The comma sets off an appositive phrase that describes the weather condition.",
                "The comma indicates that letters or words have been omitted from the sentence."
            ],
            correct: 0, 
            explanation: "Jawaban Benar: A\n\n\n\nKalimat 'Because it was raining' adalah klausa dependen (subordinat) yang tidak dapat berdiri sendiri karena belum sempurna maknanya. Aturannya, jika kalimat diawali dengan klausa dependen, harus ada koma setelahnya untuk memisahkannya dari klausa utama ('I took my umbrella')."
        },
        {
            id: 2,
            video: "Video 18a",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "According to the rules of punctuation, which of the following represents the three primary uses of an apostrophe?",
            options: [
                "To show possession, to form plural nouns, and to combine two independent clauses.",
                "To introduce a list, to form contractions, and to show possession.",
                "To show possession, to indicate plurals of letters and numbers, and to form contractions.",
                "To indicate missing letters, to separate adjectives, and to form regular plural nouns."
            ],
            correct: 2, 
            explanation: "Jawaban Benar: C\n\n\n\nApostrof digunakan dalam tiga cara utama: untuk menunjukkan kepemilikan (possession), bentuk jamak dari angka/huruf spesifik, dan untuk kontraksi (menunjukkan huruf/angka yang dihilangkan)."
        },
        {
            id: 3,
            video: "Video 18f",
            category: "C3 - Menerapkan (30 Poin)",
            points: 30,
            text: "Which of the following sentences correctly applies commas to set off a parenthetical expression or interrupter?",
            options: [
                "We could go to the party I suppose, if we aren't too late.",
                "We could go to the party, I suppose, if we aren't too late.",
                "We could go, to the party I suppose if we aren't too late.",
                "We could go to the party I suppose if we aren't too late."
            ],
            correct: 1, 
            explanation: "Jawaban Benar: B\n\nFrasa 'I suppose' adalah ekspresi yang disisipkan (interrupter) yang tidak secara gramatikal wajib ada dalam kalimat. Oleh karena itu, frasa ini harus diapit oleh koma di sebelum dan sesudahnya agar tidak mengganggu aliran kalimat utama."
        },
        {
            id: 4,
            video: "Video 18c",
            category: "C2 - Memahami (20 Poin)",
            points: 20,
            text: "Why is the colon incorrectly placed in the sentence: 'The recipe contained: flour, sugar, and eggs'?",
            options: [
                "Because a colon should only be used to introduce lists of more than four items.",
                "Because the items in the list must be separated by semicolons when a colon is used.",
                "Because the word 'contained' must always be followed by the phrase 'the following' to be grammatically correct.",
                "Because the list directly functions as the object of the verb without a formal introductory independent clause."
            ],
            correct: 3, 
            explanation: "Jawaban Benar: D\n\nTitik dua tidak diperlukan jika daftar tersebut berfungsi langsung sebagai objek dari kata kerja (seperti 'contained') tanpa didahului oleh frasa pengantar atau klausa independen yang lengkap."
        },
        {
            id: 5,
            video: "Video 18b & 18e",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "In the context of sentence structure, an independent clause is defined as:",
            options: [
                "A complete sentence that can stand alone.",
                "A sentence fragment that is missing a subject or a verb.",
                "A clause that begins with subordinating words like 'because' or 'since'.",
                "A phrase that interrupts the natural flow of a sentence."
            ],
            correct: 0, 
            explanation: "Jawaban Benar: A\n\nKlausa independen secara definisi adalah kalimat lengkap yang memiliki subjek dan predikat, serta dapat berdiri sendiri secara gramatikal."
        },
        {
            id: 6,
            video: "Video 18a",
            category: "C3 - Menerapkan (30 Poin)",
            points: 30,
            text: "Identify the sentence that demonstrates the correct application of apostrophes for both plural and singular possessive nouns.",
            options: [
                "The mens' department is on the second floor, and the girl's toys are on the first floor.",
                "The men's department is on the second floor, and the girls' toys are on the first floor.",
                "The men's department is on the second floor, and the girls's toys are on the first floor.",
                "The mens department is on the second floor, and the girls toys are on the first floor."
            ],
            correct: 1, 
            explanation: "Jawaban Benar: B\n\n\n\n'Men' adalah kata benda jamak yang TIDAK berakhiran 's', maka ditambah apostrof lalu 's' (men's). 'Girls' adalah kata benda jamak yang BERAKHIRAN 's', maka cukup ditambah apostrof di akhirnya saja (girls')."
        },
        {
            id: 7,
            video: "Video 18b",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "In which of the following situations is a colon appropriately used to introduce a formal quotation?",
            options: [
                "Right after a dependent clause that leads into the quote.",
                "Immediately after verbs like 'said' or 'stated' without an independent clause.",
                "Directly before any quotation regardless of the preceding clause.",
                "Immediately after a complete independent clause that introduces the quote."
            ],
            correct: 3, 
            explanation: "Jawaban Benar: D\n\nTitik dua (colon) digunakan tepat setelah klausa independen (kalimat lengkap) untuk memperkenalkan sebuah kutipan formal atau panjang."
        },
        {
            id: 8,
            video: "Video 18a",
            category: "C2 - Memahami (20 Poin)",
            points: 20,
            text: "How does the rule differ when adding an apostrophe to a singular noun ending in 's' (like 'James' or 'Jones') compared to a regular singular noun?",
            options: [
                "You must only add an apostrophe at the end, and never add another 's' under any circumstances.",
                "You treat it like a plural noun not ending in 's' and change the spelling of the word before adding the apostrophe.",
                "You typically add an apostrophe and an 's', but if it is hard to pronounce, placing just the apostrophe at the end is acceptable.",
                "You do not use an apostrophe at all; possession is shown by context alone."
            ],
            correct: 2, 
            explanation: "Jawaban Benar: C\n\nSecara umum, tetap ditambahkan apostrof dan 's' (seperti James's). Namun, aturannya memperbolehkan jika menghasilkan kata yang sangat sulit diucapkan, Anda boleh hanya menyematkan apostrof di akhir kata (James')."
        },
        {
            id: 9,
            video: "Video 18f",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "What is the grammatical term for a word or phrase placed next to a noun that renames or explains it, which must be set off by commas?",
            options: [
                "A subordinate clause.",
                "A parenthetical expression.",
                "A coordinating conjunction.",
                "An appositive."
            ],
            correct: 3, 
            explanation: "Jawaban Benar: D\n\nApositif (appositive) adalah kata atau frasa yang ditempatkan tepat di sebelah kata benda untuk mengganti nama atau menjelaskannya, dan umumnya diapit oleh koma."
        },
        {
            id: 10,
            video: "Video 18e",
            category: "C3 - Menerapkan (30 Poin)",
            points: 30,
            text: "Which of the following sentences correctly applies the comma rule for compound sentences joined by a coordinating conjunction?",
            options: [
                "I wanted to finish the project quickly, but I realized it would take a long time.",
                "I wanted to finish the project quickly but, I realized it would take a long time.",
                "I wanted to finish the project quickly, but realized it would take a long time.",
                "I wanted to finish the project quickly but I realized it would take a long time."
            ],
            correct: 0, 
            explanation: "Jawaban Benar: A\n\n\n\nKalimat majemuk menghubungkan dua klausa independen (yang masing-masing bisa berdiri sendiri dengan subjek dan predikat). Koma WAJIB diletakkan tepat sebelum konjungsi koordinatif ('but', 'and', 'or', dll)."
        },
        {
            id: 11,
            video: "Video 18d",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "Which of the following words requires a comma immediately after it when used as an introductory connective at the beginning of a sentence?",
            options: [
                "Because.",
                "Therefore.",
                "Whenever.",
                "Although."
            ],
            correct: 1, 
            explanation: "Jawaban Benar: B\n\nKata 'Therefore' (oleh karena itu) adalah kata penghubung/transisi pengantar. Aturannya mengharuskan penempatan koma tepat setelah kata-kata seperti however, therefore, as a result di awal kalimat."
        },
        {
            id: 12,
            video: "Video 18c",
            category: "C1 - Mengingat (10 Poin)",
            points: 10,
            text: "According to the rules for colons, which specific word or phrase strongly indicates that a colon should be used before a list?",
            options: [
                "Including.",
                "Such as.",
                "Contained.",
                "The following."
            ],
            correct: 3, 
            explanation: "Jawaban Benar: D\n\nKata 'the following' (berikut ini) secara eksplisit menandakan bahwa kalimat independen telah selesai dan daftar akan segera dimulai, sehingga diwajibkan menggunakan titik dua (colon) setelahnya."
        }
    ];

    let quizData = [];
    const userAnswers = {};
    const totalPossiblePoints = rawQuizData.reduce((sum, q) => sum + q.points, 0);

    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    function initQuiz() {
        const container = document.getElementById('quiz-container');
        if (!container) return;
        
        container.innerHTML = ''; 
        quizData = shuffleArray([...rawQuizData]);

        const questionsPerPage = 3;
        const totalPages = Math.ceil(quizData.length / questionsPerPage);

        for (let i = 0; i < totalPages; i++) {
            const stepDiv = document.createElement('div');
            stepDiv.className = `step ${i === 0 ? 'active' : ''}`;
            stepDiv.id = `step-${i}`;

            const startIdx = i * questionsPerPage;
            const endIdx = Math.min(startIdx + questionsPerPage, quizData.length);
            const pageQuestions = quizData.slice(startIdx, endIdx);

            let html = ``;
            
            pageQuestions.forEach((q, indexOnPage) => {
                const displayNum = startIdx + indexOnPage + 1;

                html += `
                <div class="card">
                    <div class="meta-tags">
                        <span class="video-tag">${q.video}</span>
                        <span class="category-tag">${q.category}</span>
                    </div>
                    <p class="question-text"><strong>${displayNum}.</strong> ${q.text}</p>
                    <div class="options">
                        ${q.options.map((opt, idx) => `
                            <label class="option-label">
                                <input type="radio" name="q${q.id}" value="${idx}">
                                <span>${opt}</span>
                            </label>
                        `).join('')}
                    </div>
                </div>`;
            });

            if (i < totalPages - 1) {
                html += `<button type="button" class="btn" onclick="nextStep(${i})">Lanjut ke Halaman Berikutnya</button>`;
            } else {
                html += `<button type="button" class="btn" style="background-color: #4caf50; color: white;" onclick="finishQuiz()">Kirim & Lihat Nilai Akhir</button>`;
            }

            stepDiv.innerHTML = html;
            container.appendChild(stepDiv);
        }

        const resultDiv = document.createElement('div');
        resultDiv.id = 'result-step';
        resultDiv.className = 'step';
        container.appendChild(resultDiv);
    }

    function nextStep(currentStepIndex) {
        const stepDiv = document.getElementById(`step-${currentStepIndex}`);
        const inputs = stepDiv.querySelectorAll('input[type="radio"]');
        const questionsOnPage = new Set();
        inputs.forEach(input => questionsOnPage.add(input.name));

        let allAnswered = true;
        questionsOnPage.forEach(name => {
            if (!document.querySelector(`input[name="${name}"]:checked`)) {
                allAnswered = false;
            }
        });

        if (!allAnswered) {
            alert("Harap jawab semua soal di halaman ini sebelum melanjutkan.");
            return;
        }

        inputs.forEach(input => {
            if (input.checked) {
                const qId = parseInt(input.name.substring(1));
                userAnswers[qId] = parseInt(input.value);
            }
        });

        document.getElementById(`step-${currentStepIndex}`).classList.remove('active');
        document.getElementById(`step-${currentStepIndex + 1}`).classList.add('active');
        window.scrollTo(0,0);
    }

    function finishQuiz() {
        const inputs = document.querySelectorAll('.step.active input[type="radio"]');
        let allAnswered = true;
        const questionsOnPage = new Set();
        inputs.forEach(input => questionsOnPage.add(input.name));

        questionsOnPage.forEach(name => {
            if (!document.querySelector(`input[name="${name}"]:checked`)) {
                allAnswered = false;
            }
        });

        if (!allAnswered) {
            alert("Harap jawab semua soal sebelum mengirimkan jawaban.");
            return;
        }

        inputs.forEach(input => {
            if (input.checked) {
                const qId = parseInt(input.name.substring(1));
                userAnswers[qId] = parseInt(input.value);
            }
        });

        calculateAndShowResults();
    }

    function calculateAndShowResults() {
        let earnedPoints = 0;
        let correctCount = 0;
        let reviewHTML = '';

        quizData.forEach((q, index) => {
            const userAnswer = userAnswers[q.id];
            const isCorrect = userAnswer === q.correct;
            
            if (isCorrect) {
                earnedPoints += q.points;
                correctCount++;
            }

            const statusClass = isCorrect ? 'correct' : 'wrong';
            const statusIcon = isCorrect ? '✅ BENAR' : '❌ SALAH';
            const pointDisplay = isCorrect ? `(+${q.points} Poin)` : `(0 Poin)`;

            reviewHTML += `
            <div class="review-item ${statusClass}">
                <div style="font-size: 0.85rem; color: #aaa; margin-bottom: 5px;">
                    Soal #${index + 1} | ${q.category}
                </div>
                <div style="font-weight: bold; margin-bottom: 10px; font-size: 1.15rem;">${q.text}</div>
                
                <div style="margin-bottom: 8px; color: ${isCorrect ? '#4caf50' : '#f44336'}; font-weight:bold;">
                    ${statusIcon} ${pointDisplay} <br>
                    <span style="font-weight:normal; color:#ddd;">Jawaban Anda: ${q.options[userAnswer]}</span>
                </div>
                
                ${!isCorrect ? `<div style="color: #4caf50; font-size: 1rem; margin-bottom:10px;"><strong>Jawaban Benar:</strong> ${q.options[q.correct]}</div>` : ''}
                
                <div class="review-explanation">
                    <span class="indonesian-flag">🇮🇩 PENJELASAN:</span>
                    <p class="explanation-text" style="white-space: pre-wrap;">${q.explanation}</p>
                </div>
            </div>`;
        });

        const finalPercentage = Math.round((earnedPoints / totalPossiblePoints) * 100);

        const resultContainer = document.getElementById('result-step');
        document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
        resultContainer.classList.add('active');

        // Added the explicit "Back to Dashboard / Menu Utama" button here
        resultContainer.innerHTML = `
            <div class="card result-box">
                <h2>Kuis Selesai!</h2>
                <div class="score-circle">
                    <span class="score-number">${finalPercentage}%</span>
                    <span class="score-label">Skor Akhir</span>
                </div>
                <p style="font-size:1.2rem;">Total Poin: <strong style="color:#4da6ff">${earnedPoints}</strong> / ${totalPossiblePoints}</p>
                <p style="color:#aaa;">Jawaban Benar: ${correctCount} dari ${quizData.length} soal</p>
                
                <div style="margin-top: 25px; display: flex; gap: 10px; flex-direction: column;">
                    <button type="button" class="btn" onclick="location.reload()">🔄 Kerjakan Ulang Kuis</button>
                    <button type="button" class="btn btn-dashboard" onclick="window.location.href='index.html'">🏠 Kembali ke Menu Utama (Dashboard)</button>
                </div>
            </div>
            
            <h3 style="margin-top: 40px; border-bottom: 1px solid #444; padding-bottom: 15px; text-align: left;">Ulasan & Penjelasan</h3>
            ${reviewHTML}
            
            <button type="button" class="btn btn-nav" onclick="window.scrollTo(0,0)" style="margin-top:30px;">⬆ Kembali ke Atas</button>
        `;

        window.scrollTo(0,0);
    }

    document.addEventListener('DOMContentLoaded', initQuiz);

</script>

</body>
</html>
